# =============================
# Homelab .gitignore (Whitelist-Based)
# =============================

# -----------------------------
# Ignore everything by default
# -----------------------------
*
!*/

# -----------------------------
# Whitelist docker-compose files (any depth)
# -----------------------------
!**/compose.yaml
!**/docker-compose.yml
!**/docker-compose.*.yml

# -----------------------------
# Whitelist envs directory (examples and encrypted only)
# -----------------------------
!**/envs/
!**/envs/*.example.env
!**/envs/*.env.enc
**/envs/*.env
**/envs/.decrypted~*.env

# -----------------------------
# Whitelist README files anywhere
# -----------------------------
!**/README.md

# -----------------------------
# Homepage config & images
# -----------------------------
!**/dashboards/homepage/
!**/dashboards/homepage/config/
!**/dashboards/homepage/config/services.yaml
!**/dashboards/homepage/config/settings.yaml
!**/dashboards/homepage/config/widgets.yaml
!**/dashboards/homepage/images/background.jpg

# -----------------------------
# Glance config
# -----------------------------
!**/dashboards/glance/glance.yml

# -----------------------------
# Recyclarr config
# -----------------------------

# Recyclarr config (keep only main config)
!media/recyclarr/
!media/recyclarr/config/
!media/recyclarr/config/recyclarr.yml

# Ignore everything else in recyclarr config
media/recyclarr/config/*
!media/recyclarr/config/recyclarr.yml

# Explicitly ignore runtime + repos
media/recyclarr/config/cache/
media/recyclarr/config/logs/
media/recyclarr/config/repositories/
media/recyclarr/config/resources/**/git/**

# -----------------------------
# Ignore sensitive data everywhere
# -----------------------------
*.key
*.pem
*.pub
*.env
!*.example.env
secrets.*
.ssh/
*.bak

# -----------------------------
# Ignore runtime / generated files
# -----------------------------
**/data/
**/configs/
node_modules/

# -----------------------------
# Ignore system & editor files
# -----------------------------
.DS_Store
*.swp
*.swo
*~
.vscode/

# -----------------------------
# Prevent deep recursion in certain stacks (but keep compose.yaml)
# -----------------------------
networking/
bots/
tunnels/linkstack/
apps/code-server/config/extensions/
!networking/compose.yaml
!bots/compose.yaml
apps/*/postgres_data/

# -----------------------------
# Remove old apps/dashboard
# -----------------------------
apps/homepage/
apps/glance